{
  "name": "seekdb-url-for-cursor",
  "displayName": "Seekdb (URL-based)",
  "description": "Add Seekdb documentation rules to .cursor/rules directory with URL-based documentation access, enabling Cursor AI assistant to understand Seekdb database knowledge by fetching online documentation",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "seekdb-url-docs.copyToRules",
        "title": "Add Seekdb Rules (URL-based)"
      },
      {
        "command": "seekdb-url-docs.removeFromRules",
        "title": "Remove Seekdb Rules (URL-based)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  },
  "publisher": "davidzhang",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidzhangbj/cursor-search-url-extension"
  },
  "license": "MIT"
}

